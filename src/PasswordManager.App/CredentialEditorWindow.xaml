<Window x:Class="PasswordManager.App.CredentialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credential" Width="590" Height="670" MinWidth="530" MinHeight="585"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="23">
        <Border Background="White" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="17" Padding="27">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="EditorHeading" Text="Add credential" FontWeight="Bold" FontSize="25" />
                    <TextBlock Text="Password fields remain masked. Changes are encrypted when saved."
                               TextWrapping="Wrap" FontSize="13" Margin="0,7,0,7"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock x:Name="EditorErrorText" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"
                                MinWidth="100" Margin="0,0,10,0" />
                        <Button Content="Save credential" Click="Save_Click" Style="{StaticResource PrimaryButton}"
                                MinWidth="155" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,1,5,2">
                        <TextBlock Text="SERVICE / TITLE *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleField" MaxLength="128" />
                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameField" MaxLength="256" />
                        <TextBlock Text="PASSWORD *" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="SecretField" MaxLength="4096" />
                        <TextBlock Text="WEBSITE / URL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UrlField" MaxLength="2048" />
                        <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NotesField" MaxLength="16384" Height="96" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
