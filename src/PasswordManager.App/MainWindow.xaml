<Window x:Class="PasswordManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Password Manager" Width="1120" Height="750"
        MinWidth="910" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
	<DockPanel LastChildFill="True">
		<Border DockPanel.Dock="Top" Height="82" Background="White"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
			<Grid Margin="35,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<Border Background="{StaticResource AccentBrush}" Width="42" Height="42" CornerRadius="11">
						<TextBlock Text="S" FontSize="23" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
					</Border>
					<StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
						<TextBlock Text="Secure Password Manager" FontSize="19" FontWeight="Bold" />
						<TextBlock Text="PRIVATE, LOCAL VAULT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
					</StackPanel>
				</StackPanel>
				<Border x:Name="AutoLockBadge"
					Grid.Column="1"
					VerticalAlignment="Center"
					Background="{StaticResource AccentPaleBrush}"
					CornerRadius="15"
					Padding="14,8"
					Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="AUTO-LOCK IN "
								   FontSize="11"
								   FontWeight="SemiBold"
								   Foreground="{StaticResource AccentBrush}" />
						<TextBlock x:Name="AutoLockCountdownText"
								   Text="05:00"
								   FontSize="11"
								   FontWeight="Bold"
								   Foreground="{StaticResource AccentBrush}" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<Grid Margin="32,26,32,28">
			<!-- First-run view -->
			<Grid x:Name="CreateView" Visibility="Collapsed">
				<Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="18" Width="535" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="35,28">
					<StackPanel>
						<Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left"
                                Background="{StaticResource AccentPaleBrush}" Margin="0,0,0,16">
							<TextBlock Text="+" FontSize="27" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<TextBlock Text="Create your encrypted vault" FontWeight="Bold" FontSize="28" />
						<TextBlock Text="Your credentials stay encrypted on this computer. There is no online account or password recovery."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   FontSize="14" Margin="0,9,0,12" />
						<TextBlock Text="MASTER PASSWORD" Style="{StaticResource FieldLabel}" />
						<PasswordBox x:Name="CreateMasterBox" MaxLength="1024" />
						<TextBlock Text="CONFIRM MASTER PASSWORD" Style="{StaticResource FieldLabel}" />
						<PasswordBox x:Name="ConfirmMasterBox" MaxLength="1024" />
						<TextBlock Text="Use at least 12 characters. Without this password the vault cannot be recovered."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                                   Margin="0,13,0,0" />
						<TextBlock x:Name="CreateErrorText" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,15,0,0" />
						<Button Content="Create vault" Style="{StaticResource PrimaryButton}"
                                Click="CreateVault_Click" Margin="0,23,0,0" />
					</StackPanel>
				</Border>
			</Grid>

			<!-- Existing vault / locked state -->
			<Grid x:Name="UnlockView" Visibility="Collapsed">
				<Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="18" Width="505" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="35,33">
					<StackPanel>
						<Border Background="{StaticResource AccentPaleBrush}" CornerRadius="16"
                                Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,17">
							<TextBlock Text="S" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
						</Border>
						<TextBlock Text="Unlock your vault" FontWeight="Bold" FontSize="30" />
						<TextBlock Text="Enter your master password to access your locally encrypted credentials."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14"
                                   Margin="0,9,0,15" />
						<TextBlock Text="MASTER PASSWORD" Style="{StaticResource FieldLabel}" />
						<PasswordBox x:Name="UnlockMasterBox" MaxLength="1024" KeyDown="UnlockMasterBox_KeyDown" />
						<TextBlock x:Name="UnlockErrorText" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,13,0,0" Visibility="Collapsed" />
						<TextBlock x:Name="RetryText" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,10,0,0" />
						<Button x:Name="UnlockButton" Content="Unlock vault" Style="{StaticResource PrimaryButton}"
                                Click="UnlockVault_Click" Margin="0,20,0,0" />
					</StackPanel>
				</Border>
			</Grid>

			<!-- Authenticated vault -->
			<Grid x:Name="VaultView" Visibility="Collapsed">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="220"/>
					<ColumnDefinition Width="20"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="20">
					<DockPanel LastChildFill="True">
						<StackPanel DockPanel.Dock="Bottom">
							<Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
							<TextBlock Text="AUTO-LOCK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
							<ComboBox x:Name="TimeoutBox" FontSize="13" Padding="7,7" SelectedIndex="1"
                                      SelectionChanged="TimeoutBox_SelectionChanged" Margin="0,0,0,12">
								<ComboBoxItem Tag="2" Content="After 2 minutes" />
								<ComboBoxItem Tag="5" Content="After 5 minutes" />
								<ComboBoxItem Tag="10" Content="After 10 minutes" />
								<ComboBoxItem Tag="20" Content="After 20 minutes" />
							</ComboBox>
							<Button Content="Lock vault" Click="LockVault_Click"
                                    Style="{StaticResource SecondaryButton}" />
						</StackPanel>
						<StackPanel>
							<TextBlock Text="MY VAULT" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" />
							<TextBlock Text="Credentials" FontSize="23" FontWeight="Bold" />
							<TextBlock Text="Encrypted at rest" Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" Margin="0,5,0,18" />
							<Border Background="{StaticResource AccentPaleBrush}" CornerRadius="11" Padding="12">
								<StackPanel>
									<TextBlock Text="Protected session" FontWeight="SemiBold" FontSize="13" />
									<TextBlock Text="Passwords stay hidden. Copy one only when needed."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" FontSize="12" />
								</StackPanel>
							</Border>
						</StackPanel>
					</DockPanel>
				</Border>

				<Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="26">
					<DockPanel LastChildFill="True">
						<StackPanel DockPanel.Dock="Top">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="Saved credentials" FontSize="27" FontWeight="Bold" />
									<TextBlock x:Name="CountText" Text="0 entries" FontSize="13"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
								</StackPanel>
								<Button Grid.Column="1" Content="+ Add entry" Click="AddEntry_Click"
                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
							</Grid>
							<TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
							<TextBox x:Name="SearchBox" MaxLength="256" TextChanged="SearchBox_TextChanged"
                                     ToolTip="Search entry titles or usernames" />
							<Grid Margin="0,18,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="SERVICE / USERNAME" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<Button x:Name="EditButton" Content="Edit" Click="EditEntry_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="13,7" Margin="0,0,7,0" />
									<Button x:Name="CopyButton" Content="Copy password" Click="CopyPassword_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="13,7" Margin="0,0,7,0" />
									<Button x:Name="DeleteButton" Content="Delete" Click="DeleteEntry_Click"
                                            Style="{StaticResource DangerButton}" Padding="13,7" />
								</StackPanel>
							</Grid>
							<Border Height="1" Background="{StaticResource LineBrush}" />
						</StackPanel>
						<Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}" Padding="11"
                                CornerRadius="9" Margin="0,12,0,0">
							<TextBlock x:Name="VaultStatusText" Text="Select an entry to edit, copy, or delete."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
						</Border>
						<Grid>
							<ListBox x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged"
                                     BorderThickness="0" Margin="0,8,0,0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Background="{StaticResource CanvasBrush}" CornerRadius="9"
                                                Padding="15,11" Margin="0,5,0,5">
											<StackPanel>
												<TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
												<TextBlock Text="{Binding Username}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
					</DockPanel>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
